PORT=4000
# Where this API is reachable. Better Auth builds its callback URLs from it.
BETTER_AUTH_URL=http://localhost:4000
# Any long random string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# The Next.js site. Allowed by CORS and trusted by Better Auth.
WEB_URL=http://localhost:3000
# Same database as packages/db. Relative SQLite paths resolve from the schema.
DATABASE_URL="file:./dev.db"
